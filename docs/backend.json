
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores personal and biometric data for an athlete, enabling nutrition and training calculations.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "activityLevel": { "type": "number" },
        "athleticDiscipline": { "type": "string" },
        "goal": { "type": "string", "enum": ["lose", "maintain", "gain"] },
        "dailyTargetCalories": { "type": "number" },
        "dailyTargetProtein": { "type": "number" },
        "dailyTargetFats": { "type": "number" },
        "dailyTargetCarbs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "firstName", "lastName", "createdAt", "updatedAt"]
    },
    "AlumnoAdmin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AlumnoAdmin",
      "type": "object",
      "description": "Datos de gestión administrativa para alumnos del equipo.",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "telefono": { "type": "string" },
        "mensualidadSugerida": { "type": "number" },
        "fechaIngreso": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nombre", "fechaIngreso"]
    },
    "PagoAlumno": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PagoAlumno",
      "type": "object",
      "description": "Registro de pagos y adeudos de los alumnos.",
      "properties": {
        "id": { "type": "string" },
        "alumnoId": { "type": "string" },
        "alumnoNombre": { "type": "string" },
        "monto": { "type": "number" },
        "fechaVencimiento": { "type": "string", "format": "date" },
        "fechaPago": { "type": "string", "format": "date-time" },
        "estado": { "type": "string", "enum": ["pagado", "pendiente", "retraso"] },
        "mesReferencia": { "type": "string", "description": "Mes al que corresponde el pago (YYYY-MM)" }
      },
      "required": ["id", "alumnoId", "monto", "fechaVencimiento", "estado"]
    },
    "BiometricMeasurement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BiometricMeasurement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "measurementDate": { "type": "string", "format": "date-time" },
        "weightKg": { "type": "number" },
        "bodyFatPercentage": { "type": "number" },
        "muscleMassPercentage": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "measurementDate", "weightKg", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/perfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores personal and biometric data for an athlete."
        }
      },
      {
        "path": "/admin_alumnos/{alumnoId}",
        "definition": {
          "entityName": "AlumnoAdmin",
          "schema": { "$ref": "#/backend/entities/AlumnoAdmin" },
          "description": "Colección de alumnos para gestión administrativa."
        }
      },
      {
        "path": "/admin_pagos/{pagoId}",
        "definition": {
          "entityName": "PagoAlumno",
          "schema": { "$ref": "#/backend/entities/PagoAlumno" },
          "description": "Registro central de pagos de la academia."
        }
      }
    ]
  }
}
