
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores personal and biometric data for an athlete, enabling nutrition and training calculations.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "activityLevel": { "type": "number" },
        "athleticDiscipline": { "type": "string" },
        "goal": { "type": "string", "enum": ["lose", "maintain", "gain"] },
        "dailyTargetCalories": { "type": "number" },
        "dailyTargetProtein": { "type": "number" },
        "dailyTargetFats": { "type": "number" },
        "dailyTargetCarbs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "firstName", "lastName", "createdAt", "updatedAt"]
    },
    "AdminAlumno": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminAlumno",
      "type": "object",
      "description": "Datos administrativos de un alumno del equipo.",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "telefono": { "type": "string" },
        "diaPago": { "type": "number" },
        "esAfiliado": { "type": "boolean" },
        "descuento": { "type": "number" },
        "montoPago": { "type": "number" },
        "fechaRegistro": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "diaPago", "montoPago"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/perfiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores personal and biometric data for an athlete."
        }
      },
      {
        "path": "/Alumnos/{alumnoId}",
        "definition": {
          "entityName": "AdminAlumno",
          "schema": { "$ref": "#/backend/entities/AdminAlumno" },
          "description": "Colección principal de gestión administrativa de alumnos."
        }
      }
    ]
  }
}
