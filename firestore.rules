rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- REGLAS TÁCTICAS ALBATROS (Hardware & API) ---
    
    // Permite que el hardware y la API registren asistencias y vinculaciones
    match /Asistencias/{asistenciaId} {
      allow read, create, update, delete: if true;
    }

    match /VinculacionesRFID/{vinculacionId} {
      allow read, create, update, delete: if true;
    }

    // Permite que la API consulte y actualice el RFID de los alumnos
    match /Alumnos/{alumnoId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid']);
      allow create, delete: if isAdmin();
    }

    // --- REGLAS DE USUARIO Y ADMINISTRACIÓN ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.email == "admin@gmail.com" ||
          request.auth.uid == "qbD1jOSrZ7d5vfDUkb2XndAAa343"
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /perfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /alimentos/{foodItemId} {
      allow read: if true;
    }

    match /admin_pagos/{document=**} {
      allow read, write: if isAdmin();
    }

    match /registro_eventos/{registrationId} {
      allow create, read: if true;
    }
  }
}
