rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la gestión de alumnos y hardware (ESP32)
    // Se permite acceso para el flujo de la API y el hardware en colecciones operativas
    match /Alumnos/{alumnoId} {
      allow read, write: if true;
    }
    
    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }
    
    match /VinculacionesRFID/{vinculacionId} {
      allow read, write: if true;
    }
    
    // Reglas para perfiles de atletas (privado por UID)
    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Reglas para base de datos de alimentos
    match /alimentos/{alimentoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}