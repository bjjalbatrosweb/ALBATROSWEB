rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el flujo táctico de hardware (públicas para facilitar integración con ESP32)
    match /VinculacionesRFID/{vincId} {
      allow read, write: if true;
    }

    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }

    match /Alumnos/{alumnoId} {
      allow read: if true;
      // Permite actualizar solo el campo rfid desde la API de vinculación
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid', 'estadoPago']);
      allow write: if request.auth != null;
    }

    // Perfiles de usuario (protegidos)
    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /alimentos/{alimentoId} {
      allow read: if true;
    }
  }
}
