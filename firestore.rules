rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && userProfile().activo == true;
    }

    function isAdmin() {
      return activeUser()
        && userProfile().rol == 'admin';
    }

    function isStaffFor(sede) {
      return activeUser()
        && (
          isAdmin()
          || (
            userProfile().rol == 'profesor'
            && userProfile().sede == sede
          )
        );
    }

    function isOwnStudent(alumnoId) {
      return activeUser()
        && userProfile().rol == 'atleta'
        && userProfile().alumnoId == alumnoId;
    }

    function isAthleteFor(sede) {
      return activeUser()
        && userProfile().rol == 'atleta'
        && userProfile().sede == sede;
    }

    match /usuarios/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /SolicitudesAcceso/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'nombre',
          'telefono',
          'sede',
          'estado',
          'creadoEn',
          'actualizadoEn'
        ]);

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.estado == 'pendiente'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'nombre',
            'telefono',
            'sede',
            'estado',
            'creadoEn',
            'actualizadoEn'
          ])
        );

      allow delete: if isAdmin();
    }

    match /SolicitudesCorreccion/{solicitudId} {
      allow read: if (
          signedIn()
          && request.auth.uid == resource.data.uid
        )
        || isStaffFor(resource.data.sede);

      allow create: if activeUser()
        && userProfile().rol == 'atleta'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alumnoId == userProfile().alumnoId
        && request.resource.data.sede == userProfile().sede
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.categoria in [
          'datos',
          'pago',
          'asistencia',
          'progreso',
          'emergencia'
        ]
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() >= 8
        && request.resource.data.detalle.size() <= 500
        && request.resource.data.keys().hasOnly([
          'uid',
          'alumnoId',
          'alumnoNombre',
          'sede',
          'categoria',
          'detalle',
          'estado',
          'creadoEn'
        ]);

      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.alumnoId == resource.data.alumnoId
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.estado in ['pendiente', 'resuelta'];

      allow delete: if isAdmin();
    }

    // Bitácora inmutable para cambios realizados desde Gestión de atletas.
    match /MovimientosAdmin/{movimientoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'accion',
          'alumnoId',
          'alumnoNombre',
          'sede',
          'detalle',
          'actorUid',
          'actorEmail',
          'creadoEn'
        ]);
      allow update, delete: if false;
    }

    // Separadas de Alumnos para que nunca formen parte del documento que
    // puede consultar el atleta.
    match /NotasPrivadasAtletas/{alumnoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.alumnoId == alumnoId;
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.alumnoId == alumnoId;
      allow delete: if isAdmin();
    }

    match /ResumenesMensuales/{resumenId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isAdmin();
    }

    match /Alumnos/{alumnoId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /Asistencias/{asistenciaId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /Pagos/{pagoId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Libro auxiliar para ingresos distintos a mensualidades y egresos.
    // Los Pagos existentes permanecen en su colección y nunca se duplican.
    match /MovimientosFinancieros/{movimientoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 10000000
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 2
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 2
        && request.resource.data.concepto.size() <= 140
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly([
          'sede', 'tipo', 'monto', 'categoria', 'concepto',
          'fecha', 'creadoPor', 'creadoEn'
        ]);
      allow update: if false;
      allow delete: if isAdmin()
        || (isStaffFor(resource.data.sede) && resource.data.creadoPor == request.auth.uid);
    }

    match /VinculacionesRFID/{vinculacionId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Índice de unicidad administrado exclusivamente por las APIs del servidor.
    // Un UID solo puede apuntar a un alumno, incluso con solicitudes simultáneas.
    match /TarjetasRFID/{rfid} {
      allow read, write: if false;
    }

    match /Pantallas/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId);
      allow delete: if isAdmin();
    }

    match /Anuncios/{anuncioId} {
      allow read: if isStaffFor(resource.data.sede)
        || isAthleteFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Calendarios de entrenamiento. El público sólo consulta publicaciones;
    // cada profesor administra su sede y el administrador puede gestionar todas.
    match /Calendarios/{calendarioId} {
      allow read: if resource.data.estado == 'publicado'
        || isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.estado == 'borrador';
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();
    }

    // Puntero ligero al calendario vigente de cada sede.
    match /CalendariosActuales/{sedeId} {
      allow read: if true;
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isStaffFor(sedeId);
    }

    match /Clases/{claseId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();
    }

    match /ClasesActivas/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isStaffFor(sedeId);
    }

    // Control independiente de la puerta del tatami. Puede utilizarse exista
    // o no una clase activa; el ESP32 lo consulta mediante una API protegida.
    match /ControlesAcceso/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isAdmin();
    }

    // Telemetría del controlador físico. El ESP32 escribe exclusivamente por
    // la API protegida; el panel sólo necesita leer el estado de su sede.
    match /DispositivosAcceso/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow write: if false;
    }

    // Incidencias compartidas por sede; no admite códigos RFID.
    match /IncidenciasOperativas/{incidenciaId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.estado == 'abierta'
        && request.resource.data.prioridad in ['baja', 'media', 'alta']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 4
        && request.resource.data.titulo.size() <= 100
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() >= 8
        && request.resource.data.detalle.size() <= 600
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly([
          'sede', 'titulo', 'detalle', 'prioridad', 'estado',
          'actorUid', 'actorEmail', 'creadoEn'
        ]);
      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.estado in ['abierta', 'resuelta'];
      allow delete: if isAdmin();
    }

    match /AsistenciasClase/{registroId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update, delete: if isStaffFor(resource.data.sede);
    }

    match /ReservasClases/{claseId} {
      allow read: if isStaffFor(resource.data.sede)
        || (isAthleteFor(resource.data.sede) && resource.data.estado == 'publicada');
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'publicada'
        && request.resource.data.reservados == 0
        && request.resource.data.cupo is int
        && request.resource.data.cupo >= 1
        && request.resource.data.cupo <= 200;
      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.cupo >= resource.data.reservados;
      allow delete: if isAdmin();

      match /inscripciones/{userId} {
        allow read: if isStaffFor(
          get(/databases/$(database)/documents/ReservasClases/$(claseId)).data.sede
        ) || (signedIn() && request.auth.uid == userId);
        // Las inscripciones se procesarán por API transaccional para impedir
        // sobrecupo y duplicados. El cliente nunca ajusta el contador.
        allow write: if false;
      }
    }

    // Auditoría inmutable. El usuario autenticado puede crear movimientos
    // únicamente en una sede que administra; nunca editarlos ni borrarlos.
    match /Auditoria/{sede}/movimientos/{movimientoId} {
      allow read: if isStaffFor(sede);
      allow create: if isStaffFor(sede)
        && request.resource.data.sede == sede
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in [
          'crear',
          'editar',
          'eliminar',
          'activar',
          'desactivar',
          'registrar_pago',
          'editar_pago',
          'cancelar_pago',
          'agregar_asistencia',
          'eliminar_asistencia',
          'reiniciar_asistencias'
        ]
        && request.resource.data.entity in [
          'alumno',
          'pago',
          'asistencia',
          'rfid'
        ]
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 240
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'action',
          'entity',
          'entityId',
          'entityName',
          'summary',
          'reason',
          'details',
          'before',
          'after',
          'sede',
          'actorUid',
          'actorName',
          'actorEmail',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    // Sesiones privadas de examen. Las inscripciones públicas y las
    // evaluaciones de sinodales escriben exclusivamente mediante APIs
    // validadas; el personal administra los documentos desde el panel.
    match /ExamenesTaekwondo/{examenId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();

      match /{documento=**} {
        allow read, write: if isStaffFor(
          get(
            /databases/$(database)/documents/ExamenesTaekwondo/$(examenId)
          ).data.sede
        );
      }
    }

    // Espejo de sesión para sincronización multidispositivo. El token del
    // documento es aleatorio; el público sólo lee y nunca escribe directo.
    match /ExamenEvaluacionPublica/{token} {
      allow read: if true;
      allow create, update: if isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /perfiles/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /{subdocumento=**} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    match /alimentos/{alimentoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contadores internos del servidor. Nunca son accesibles desde el SDK cliente.
    match /RateLimits/{limitId} {
      allow read, write: if false;
    }

    // Suscripciones FCM y bitácora mensual. Sólo las rutas de servidor y las
    // funciones programadas pueden leer o modificar estos documentos.
    match /DispositivosNotificacion/{dispositivoId} {
      allow read, write: if false;
    }

    match /RecordatoriosPago/{recordatorioId} {
      allow read, write: if false;
    }

    // Telemetría técnica con retención limitada, escrita solo por el servidor.
    match /ErroresWeb/{errorId} {
      allow read, write: if false;
    }

    // Bloques de diagnóstico del ESP32. Sólo las APIs autenticadas del
    // servidor pueden escribirlos o consultarlos; nunca el SDK del navegador.
    match /MonitorDispositivos/{sede}/{documento=**} {
      allow read, write: if false;
    }
  }
}
