rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acceso total a las colecciones operativas del sistema
    match /Alumnos/{alumnoId} {
      allow read, write: if true;
    }
    
    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }
    
    match /VinculacionesRFID/{vinculacionId} {
      allow read, write: if true;
    }
    
    // Reglas para perfiles de atletas (privado por UID)
    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para base de datos de alimentos
    match /alimentos/{alimentoId} {
      allow read: if true;
    }
  }
}
