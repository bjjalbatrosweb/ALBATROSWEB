rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfiles de Usuario
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if true;
    }

    // Registro de Eventos (Público)
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Gestión de Alumnos - Acceso total para el panel administrativo (PIN)
    // Se permite el listado a nivel de colección y el acceso a documentos individuales
    match /Alumnos/{allPaths=**} {
      allow read, write: if true;
    }

    // Admin alumnos (Colección anterior, mantenida por compatibilidad)
    match /admin_alumnos/{document=**} {
      allow read, write: if true;
    }

    // Admin pagos
    match /admin_pagos/{document=**} {
      allow read, write: if true;
    }
  }
}