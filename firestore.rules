rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario (Acceso Guerrero)
    // Los atletas solo pueden acceder a su propio nodo de datos
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (Acceso Maestro)
    // Estas colecciones son independientes y solo accesibles por el personal autorizado (Admin)
    // Se permite el acceso a cualquier usuario autenticado (incluyendo sesión anónima de admin)
    match /admin_alumnos/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /admin_pagos/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Reglas adicionales para la base de datos pública y eventos
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}
