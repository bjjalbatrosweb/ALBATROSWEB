
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfiles de Usuario
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    // Registro de Eventos (Público)
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    // Reglas para colecciones administrativas
    // Se permite el acceso público para soportar el login independiente por PIN del profesor
    match /admin_alumnos/{document=**} {
      allow read, write: if true;
    }
    
    match /Alumnos/{document=**} {
      allow read, write: if true;
    }
    
    match /admin_pagos/{document=**} {
      allow read, write: if true;
    }

    // Comentario de despliegue: Vinculación definitiva de la colección 'Alumnos' para gestión táctica.
  }
}
