rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario
    match /perfiles/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Permitir acceso a subcolecciones de usuario
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (admin_alumnos y admin_pagos)
    // Se permite el acceso total a cualquier usuario autenticado (incluyendo anónimos)
    match /admin_alumnos/{alumnoId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /admin_pagos/{pagoId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}