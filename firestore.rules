rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REGLAS PÚBLICAS (HARDWARE Y API ROUTES) ---

    // Vinculaciones RFID: Acceso total para la API y el ESP32
    match /VinculacionesRFID/{vinculacionId} {
      allow read, write: if true; 
    }

    // Log de Asistencias: El hardware registra, el admin gestiona
    match /Asistencias/{asistenciaId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Gestión de Alumnos: Acceso público para lectura y actualización específica de RFID vía API
    match /Alumnos/{alumnoId} {
      allow read: if true; 
      allow create, delete: if isAdmin();
      // Permite a la API (sin sesión) actualizar SOLO el campo 'rfid'
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid'])) || isAdmin();
    }

    // --- FUNCIONES DE APOYO ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'admin@gmail.com' || request.auth.uid == 'qbD1jOSrZ7d5vfDUkb2XndAAa343');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- REGLAS DE USUARIOS Y OTROS ---

    match /perfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /alimentos/{foodItemId} {
      allow read: if true;
    }

    match /admin_pagos/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /registro_eventos/{registrationId} {
      allow create, read: if true;
    }
  }
}