rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario (Acceso Guerrero)
    // Los atletas solo pueden ver y editar su propio perfil y sus subcolecciones
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (Acceso Maestro)
    // Acceso independiente: No requiere login de Firebase para permitir gestión externa
    match /admin_alumnos/{allPaths=**} {
      allow read, write: if true;
    }
    
    match /admin_pagos/{allPaths=**} {
      allow read, write: if true;
    }

    // Reglas adicionales para la base de datos de alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    // Reglas para registro de eventos (Inscripciones públicas)
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}