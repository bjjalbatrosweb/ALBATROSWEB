rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /VinculacionesRFID/{vincId} {
      allow read, write: if true;
    }

    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }

    match /Alumnos/{alumnoId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid', 'estadoPago']);
      allow write: if request.auth != null;
    }

    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /mealLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /trainingSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /alimentos/{alimentoId} {
      allow read: if request.auth != null;
    }
  }
}