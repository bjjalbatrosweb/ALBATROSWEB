rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfiles de Usuario
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    // Registro de Eventos (Público)
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    // Reglas para colecciones administrativas
    // Se permite el acceso público (sin Firebase Auth) para soportar el login independiente por PIN
    match /admin_alumnos/{docId} {
      allow read, write: if true;
    }
    
    match /admin_pagos/{docId} {
      allow read, write: if true;
    }
    
    // Soporte para listado y subrutas administrativas (Recursivo para asegurar 'list' y 'get')
    match /admin_alumnos/{allPaths=**} {
      allow read, write: if true;
    }
    
    match /admin_pagos/{allPaths=**} {
      allow read, write: if true;
    }

    // Comentario para forzar despliegue: Reglas de acceso táctico administrativo aplicadas para modo PIN.
  }
}