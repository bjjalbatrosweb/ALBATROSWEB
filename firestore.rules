rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario (Acceso Guerrero)
    // Los atletas solo pueden ver y editar su propio perfil
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (Acceso Maestro)
    // El administrador usa una sesión anónima independiente
    match /admin_alumnos/{docId} {
      allow read, write: if isSignedIn();
    }
    
    match /admin_pagos/{docId} {
      allow read, write: if isSignedIn();
    }

    // Reglas adicionales para la base de datos pública y eventos
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}