
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'admin@gmail.com' || request.auth.uid == 'qbD1jOSrZ7d5vfDUkb2XndAAa343');
    }

    // Perfiles de Usuario
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if true;
    }

    // Gestión de Alumnos
    match /Alumnos/{alumnoId} {
      allow read: if true; 
      allow create, delete: if isAdmin();
      // Permitir actualización total a admin, o actualización de solo RFID para la API
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid']));
    }

    // Log de Asistencias
    match /Asistencias/{asistenciaId} {
      allow create: if true; // El hardware registra asistencias
      allow read, delete: if isAdmin(); // El admin ve y reinicia
    }

    // Vinculaciones RFID (Protocolo de hardware)
    match /VinculacionesRFID/{vinculacionId} {
      allow read, write: if true; 
    }

    // Admin pagos y otros
    match /admin_pagos/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /registro_eventos/{registrationId} {
      allow create, read: if true;
    }
  }
}
