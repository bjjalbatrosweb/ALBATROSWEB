rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && userProfile().activo == true;
    }

    function isAdmin() {
      return activeUser()
        && userProfile().rol == 'admin';
    }

    function isStaffFor(sede) {
      return activeUser()
        && (
          isAdmin()
          || (
            userProfile().rol == 'profesor'
            && userProfile().sede == sede
          )
        );
    }

    function isOwnStudent(alumnoId) {
      return activeUser()
        && userProfile().rol == 'atleta'
        && userProfile().alumnoId == alumnoId;
    }

    function isAthleteFor(sede) {
      return activeUser()
        && userProfile().rol == 'atleta'
        && userProfile().sede == sede;
    }

    function validAthletePhoto(data, alumnoId) {
      return data.keys().hasOnly([
          'alumnoId', 'usuarioId', 'sede', 'imagenDataUrl',
          'mimeType', 'bytes', 'actualizadoEn'
        ])
        && data.keys().hasAll([
          'alumnoId', 'usuarioId', 'sede', 'imagenDataUrl',
          'mimeType', 'bytes', 'actualizadoEn'
        ])
        && data.alumnoId == alumnoId
        && data.usuarioId == request.auth.uid
        && data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && data.imagenDataUrl is string
        && data.imagenDataUrl.size() >= 100
        && data.imagenDataUrl.size() <= 250000
        && data.imagenDataUrl.matches('^data:image/jpeg;base64,.*')
        && data.mimeType == 'image/jpeg'
        && data.bytes is int
        && data.bytes > 0
        && data.bytes <= 184320
        && data.actualizadoEn == request.time;
    }

    function optionalNumberInRange(data, key, minimum, maximum) {
      return !(key in data)
        || (
          data[key] is number
          && data[key] >= minimum
          && data[key] <= maximum
        );
    }

    function validWellness(data) {
      return data.keys().hasOnly([
          'fecha', 'energia', 'sueno', 'dolor', 'animo',
          'horasSueno', 'pulsoReposo', 'presionSistolica',
          'presionDiastolica', 'zonaDolor', 'alumnoId',
          'usuarioId', 'sede', 'actualizadoEn'
        ])
        && data.fecha is string
        && data.fecha.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.energia is int && data.energia >= 1 && data.energia <= 5
        && data.sueno is int && data.sueno >= 1 && data.sueno <= 5
        && data.dolor is int && data.dolor >= 0 && data.dolor <= 5
        && data.animo is int && data.animo >= 1 && data.animo <= 5
        && data.alumnoId is string
        && data.usuarioId is string
        && data.sede is string
        && optionalNumberInRange(data, 'horasSueno', 0, 16)
        && optionalNumberInRange(data, 'pulsoReposo', 25, 220)
        && optionalNumberInRange(data, 'presionSistolica', 50, 260)
        && optionalNumberInRange(data, 'presionDiastolica', 30, 180)
        && (!('zonaDolor' in data) || (data.zonaDolor is string && data.zonaDolor.size() <= 80));
    }

    function validCombatStyleProfile(data, alumnoId) {
      return data.keys().hasOnly([
          'alumnoId', 'alumnoNombre', 'sede', 'genero', 'estatura',
          'alturaCm', 'pesoKg', 'envergaduraCm', 'cinturaCm', 'caderaCm',
          'musloCm', 'complexion', 'torso', 'brazos', 'piernas',
          'hombros', 'cintura', 'cadera', 'gluteos', 'muslos', 'manos',
          'movilidad', 'explosividad', 'resistencia', 'agarre',
          'equilibrio', 'velocidad', 'controlCorporal',
          'experiencia', 'guardia', 'objetivos', 'restricciones', 'notas',
          'versionMotor', 'actualizadoPor', 'actualizadoEn', 'creadoEn'
        ])
        && data.keys().hasAll([
          'alumnoId', 'alumnoNombre', 'sede', 'genero', 'estatura',
          'complexion', 'torso', 'brazos', 'piernas', 'hombros',
          'cintura', 'cadera', 'gluteos', 'muslos', 'manos',
          'movilidad', 'explosividad', 'resistencia', 'agarre',
          'equilibrio', 'velocidad', 'controlCorporal',
          'experiencia', 'guardia', 'objetivos',
          'restricciones', 'notas', 'versionMotor',
          'actualizadoPor', 'actualizadoEn', 'creadoEn'
        ])
        && data.alumnoId == alumnoId
        && data.alumnoNombre is string
        && data.alumnoNombre.size() >= 1
        && data.alumnoNombre.size() <= 120
        && data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && data.genero in ['mujer', 'hombre', 'otro', 'sin_especificar']
        && data.estatura in ['baja', 'media', 'alta']
        && data.complexion in ['compacta', 'equilibrada', 'longilinea', 'robusta']
        && data.torso in ['corta', 'media', 'larga']
        && data.brazos in ['corta', 'media', 'larga']
        && data.piernas in ['corta', 'media', 'larga']
        && data.hombros in ['estrecha', 'media', 'ancha']
        && data.cintura in ['estrecha', 'media', 'ancha']
        && data.cadera in ['estrecha', 'media', 'ancha']
        && data.gluteos in ['estrecha', 'media', 'ancha']
        && data.muslos in ['estrecha', 'media', 'ancha']
        && data.manos in ['estrecha', 'media', 'ancha']
        && data.movilidad in ['por_desarrollar', 'media', 'destacada']
        && data.explosividad in ['por_desarrollar', 'media', 'destacada']
        && data.resistencia in ['por_desarrollar', 'media', 'destacada']
        && data.agarre in ['por_desarrollar', 'media', 'destacada']
        && data.equilibrio in ['por_desarrollar', 'media', 'destacada']
        && data.velocidad in ['por_desarrollar', 'media', 'destacada']
        && data.controlCorporal in ['por_desarrollar', 'media', 'destacada']
        && data.experiencia in ['inicial', 'intermedia', 'avanzada']
        && data.guardia in ['diestra', 'zurda', 'cambiante', 'sin_definir']
        && optionalNumberInRange(data, 'alturaCm', 80, 230)
        && optionalNumberInRange(data, 'pesoKg', 15, 250)
        && optionalNumberInRange(data, 'envergaduraCm', 70, 260)
        && optionalNumberInRange(data, 'cinturaCm', 30, 200)
        && optionalNumberInRange(data, 'caderaCm', 40, 220)
        && optionalNumberInRange(data, 'musloCm', 20, 120)
        && data.objetivos is list
        && data.objetivos.size() <= 4
        && data.restricciones is string
        && data.restricciones.size() <= 500
        && data.notas is string
        && data.notas.size() <= 500
        && data.versionMotor in ['perfil-tecnico-v1', 'perfil-tecnico-v2']
        && data.actualizadoPor == request.auth.uid
        && data.actualizadoEn == request.time;
    }

    function validPublicSubmission(item) {
      return item is map
        && item.keys().hasOnly(['name', 'entry', 'family', 'caution', 'priority', 'why'])
        && item.keys().hasAll(['name', 'entry', 'family', 'caution', 'priority', 'why'])
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 100
        && item.entry is string && item.entry.size() >= 1 && item.entry.size() <= 180
        && item.family in ['estrangulación', 'brazo', 'hombro']
        && item.caution is string && item.caution.size() >= 1 && item.caution.size() <= 220
        && item.priority in ['Principal', 'Alternativa']
        && item.why is string && item.why.size() >= 1 && item.why.size() <= 260;
    }

    function validPublicRoute(item) {
      return item is map
        && item.keys().hasOnly(['domain', 'title', 'summary', 'techniques', 'reason', 'drill', 'watch'])
        && item.keys().hasAll(['domain', 'title', 'summary', 'techniques', 'reason', 'drill', 'watch'])
        && item.domain in ['Grappling', 'Wrestling', 'Striking']
        && item.title is string && item.title.size() >= 1 && item.title.size() <= 160
        && item.summary is string && item.summary.size() >= 1 && item.summary.size() <= 300
        && item.techniques is list && item.techniques.size() == 3
        && item.reason is string && item.reason.size() >= 1 && item.reason.size() <= 300
        && item.drill is string && item.drill.size() >= 1 && item.drill.size() <= 400
        && item.watch is string && item.watch.size() >= 1 && item.watch.size() <= 400;
    }

    function validPublicPlan(item) {
      return item is map
        && item.keys().hasOnly(['session', 'task', 'measure'])
        && item.keys().hasAll(['session', 'task', 'measure'])
        && item.session is string && item.session.size() >= 1 && item.session.size() <= 40
        && item.task is string && item.task.size() >= 1 && item.task.size() <= 100
        && item.measure is string && item.measure.size() >= 1 && item.measure.size() <= 300;
    }

    function validPublicDeprioritized(item) {
      return item is map
        && item.keys().hasOnly(['id', 'domain', 'technique', 'status', 'reason', 'alternative', 'validation'])
        && item.keys().hasAll(['id', 'domain', 'technique', 'status', 'reason', 'alternative', 'validation'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 100
        && item.domain in ['Grappling', 'Wrestling', 'Striking']
        && item.technique is string && item.technique.size() >= 1 && item.technique.size() <= 180
        && item.status in ['Menor prioridad', 'Evitar por ahora']
        && item.reason is string && item.reason.size() >= 1 && item.reason.size() <= 350
        && item.alternative is string && item.alternative.size() >= 1 && item.alternative.size() <= 350
        && item.validation is string && item.validation.size() >= 1 && item.validation.size() <= 350;
    }

    function validPublicDeprioritizedList(items) {
      return items is list
        && items.size() <= 4
        && (items.size() < 1 || validPublicDeprioritized(items[0]))
        && (items.size() < 2 || validPublicDeprioritized(items[1]))
        && (items.size() < 3 || validPublicDeprioritized(items[2]))
        && (items.size() < 4 || validPublicDeprioritized(items[3]));
    }

    function validPublicPhysical(profile) {
      return profile is map
        && profile.keys().hasOnly(['estatura', 'complexion', 'torso', 'brazos', 'piernas', 'hombros', 'cintura', 'cadera', 'gluteos', 'muslos'])
        && profile.keys().hasAll(['estatura', 'complexion', 'torso', 'brazos', 'piernas', 'hombros', 'cintura', 'cadera', 'gluteos', 'muslos'])
        && profile.estatura in ['Baja', 'Media', 'Alta']
        && profile.complexion in ['Compacta', 'Equilibrada', 'Longilínea', 'Robusta']
        && profile.torso in ['Corto/a', 'Medio/a', 'Largo/a']
        && profile.brazos in ['Corto/a', 'Medio/a', 'Largo/a']
        && profile.piernas in ['Corto/a', 'Medio/a', 'Largo/a']
        && profile.hombros in ['Estrecho/a', 'Medio/a', 'Ancho/a']
        && profile.cintura in ['Estrecho/a', 'Medio/a', 'Ancho/a']
        && profile.cadera in ['Estrecho/a', 'Medio/a', 'Ancho/a']
        && profile.gluteos in ['Estrecho/a', 'Medio/a', 'Ancho/a']
        && profile.muslos in ['Estrecho/a', 'Medio/a', 'Ancho/a'];
    }

    function validPublicCombatContent(content) {
      return content is map
        && content.keys().hasOnly(['version', 'qualityLabel', 'athleteName', 'physicalProfile', 'submissions', 'deprioritized', 'primaryRoutes', 'validationPlan'])
        && content.keys().hasAll(['version', 'qualityLabel', 'submissions', 'primaryRoutes', 'validationPlan'])
        && content.version in [1, 2]
        && content.qualityLabel is string && content.qualityLabel.size() >= 1 && content.qualityLabel.size() <= 80
        && (!('athleteName' in content) || (content.athleteName is string && content.athleteName.size() >= 1 && content.athleteName.size() <= 100))
        && (!('physicalProfile' in content) || validPublicPhysical(content.physicalProfile))
        && content.submissions is list && content.submissions.size() == 4
        && validPublicSubmission(content.submissions[0])
        && validPublicSubmission(content.submissions[1])
        && validPublicSubmission(content.submissions[2])
        && validPublicSubmission(content.submissions[3])
        && (content.version == 1 || (('deprioritized' in content) && validPublicDeprioritizedList(content.deprioritized)))
        && content.primaryRoutes is list && content.primaryRoutes.size() == 3
        && validPublicRoute(content.primaryRoutes[0])
        && validPublicRoute(content.primaryRoutes[1])
        && validPublicRoute(content.primaryRoutes[2])
        && content.validationPlan is list && content.validationPlan.size() == 4
        && validPublicPlan(content.validationPlan[0])
        && validPublicPlan(content.validationPlan[1])
        && validPublicPlan(content.validationPlan[2])
        && validPublicPlan(content.validationPlan[3]);
    }

    function validPublicCombatShare(data, token) {
      return data.keys().hasOnly(['token', 'sede', 'activo', 'creadoEn', 'venceEn', 'contenido'])
        && data.keys().hasAll(['token', 'sede', 'activo', 'creadoEn', 'venceEn', 'contenido'])
        && data.token == token
        && data.token is string && data.token.size() >= 32 && data.token.size() <= 80
        && data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && data.activo == true
        && data.creadoEn == request.time
        && data.venceEn is timestamp
        && data.venceEn > request.time
        && data.venceEn <= request.time + duration.value(90, 'd')
        && validPublicCombatContent(data.contenido);
    }

    function validAthleteCombatResponse() {
      return resource.data.activo == true
        && resource.data.venceEn > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestaAtleta', 'comentarioAtleta', 'respondidoEn'])
        && request.resource.data.respuestaAtleta in ['coincide', 'parcial', 'no_coincide']
        && request.resource.data.comentarioAtleta is string
        && request.resource.data.comentarioAtleta.size() <= 300
        && request.resource.data.respondidoEn == request.time;
    }

    match /usuarios/{userId} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /SolicitudesAcceso/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'nombre',
          'telefono',
          'sede',
          'estado',
          'creadoEn',
          'actualizadoEn'
        ]);

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.estado == 'pendiente'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'nombre',
            'telefono',
            'sede',
            'estado',
            'creadoEn',
            'actualizadoEn'
          ])
        );

      allow delete: if isAdmin();
    }

    match /SolicitudesCorreccion/{solicitudId} {
      allow read: if (
          signedIn()
          && request.auth.uid == resource.data.uid
        )
        || isStaffFor(resource.data.sede);

      allow create: if activeUser()
        && userProfile().rol == 'atleta'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.alumnoId == userProfile().alumnoId
        && request.resource.data.sede == userProfile().sede
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.categoria in [
          'datos',
          'pago',
          'asistencia',
          'progreso',
          'emergencia'
        ]
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() >= 8
        && request.resource.data.detalle.size() <= 500
        && request.resource.data.keys().hasOnly([
          'uid',
          'alumnoId',
          'alumnoNombre',
          'sede',
          'categoria',
          'detalle',
          'estado',
          'creadoEn'
        ]);

      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.alumnoId == resource.data.alumnoId
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.estado in ['pendiente', 'resuelta'];

      allow delete: if isAdmin();
    }

    // Formularios públicos del kiosco. El público sólo puede crear solicitudes
    // estrictamente validadas; únicamente el personal puede leerlas o resolverlas.
    match /SolicitudesClasePrueba/{solicitudId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() >= 10
        && request.resource.data.telefono.size() <= 15
        && request.resource.data.disciplina in ['Jiu-Jitsu', 'Kick Boxing', 'MMA']
        && request.resource.data.sede in ['MMA', 'CAUCEL', 'JUAN_PABLO']
        && request.resource.data.horario is string
        && request.resource.data.horario.size() >= 4
        && request.resource.data.horario.size() <= 80
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 300
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.origen == 'kiosco'
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly([
          'nombre', 'telefono', 'disciplina', 'sede', 'horario',
          'notas', 'estado', 'origen', 'creadoEn'
        ]);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();
    }

    // Bitácora inmutable para cambios realizados desde Gestión de atletas.
    match /MovimientosAdmin/{movimientoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'accion',
          'alumnoId',
          'alumnoNombre',
          'sede',
          'detalle',
          'actorUid',
          'actorEmail',
          'creadoEn'
        ]);
      allow update, delete: if false;
    }

    // Separadas de Alumnos para que nunca formen parte del documento que
    // puede consultar el atleta.
    match /NotasPrivadasAtletas/{alumnoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.alumnoId == alumnoId;
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.alumnoId == alumnoId;
      allow delete: if isAdmin();
    }

    match /ResumenesMensuales/{resumenId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isAdmin();
    }

    match /Alumnos/{alumnoId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if (
          isStaffFor(resource.data.sede)
          && isStaffFor(request.resource.data.sede)
        ) || (
          isOwnStudent(alumnoId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fotoUrl', 'fotoStoragePath', 'fotoActualizadaEn'
          ])
          && (!('fotoUrl' in request.resource.data)
            || (request.resource.data.fotoUrl is string
              && request.resource.data.fotoUrl.size() <= 2048))
          && (!('fotoStoragePath' in request.resource.data)
            || (request.resource.data.fotoStoragePath is string
              && request.resource.data.fotoStoragePath.size() <= 300))
          && request.resource.data.fotoActualizadaEn == request.time
        );
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Avatar compacto separado del expediente principal. Esto permite que el
    // atleta gestione su foto sin Firebase Storage y sin exponer otros datos.
    match /FotosAtletas/{alumnoId} {
      allow read: if isOwnStudent(alumnoId)
        || isStaffFor(resource.data.sede);
      allow create: if isOwnStudent(alumnoId)
        && validAthletePhoto(request.resource.data, alumnoId);
      allow update: if isOwnStudent(alumnoId)
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.sede == resource.data.sede
        && validAthletePhoto(request.resource.data, alumnoId);
      allow delete: if isOwnStudent(alumnoId)
        || isStaffFor(resource.data.sede);
    }

    // Perfil privado del coach. La morfología se usa como hipótesis técnica,
    // nunca como diagnóstico ni como dato público del atleta.
    match /PerfilesTecnicosAtletas/{alumnoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && validCombatStyleProfile(request.resource.data, alumnoId)
        && request.resource.data.creadoEn == request.time;
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.alumnoId == resource.data.alumnoId
        && request.resource.data.creadoEn == resource.data.creadoEn
        && validCombatStyleProfile(request.resource.data, alumnoId);
      allow delete: if isAdmin();
    }

    // Instantánea pública y sanitizada. El token es impredecible, caduca y
    // nunca contiene medidas exactas, salud ni notas privadas del coach.
    match /PerfilesTecnicosCompartidos/{token} {
      allow get: if (
          resource.data.activo == true
          && resource.data.venceEn > request.time
        ) || isStaffFor(resource.data.sede);
      allow list: if false;
      allow create: if isStaffFor(request.resource.data.sede)
        && validPublicCombatShare(request.resource.data, token);
      allow update: if (
          isStaffFor(resource.data.sede)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo'])
          && request.resource.data.activo == false
        ) || validAthleteCombatResponse();
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Registro privado de bienestar creado por el propio atleta.
    match /BienestarAtletas/{registroId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isOwnStudent(request.resource.data.alumnoId)
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.sede == userProfile().sede
        && validWellness(request.resource.data);
      allow update: if isOwnStudent(resource.data.alumnoId)
        && request.resource.data.alumnoId == resource.data.alumnoId
        && request.resource.data.usuarioId == resource.data.usuarioId
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.sede == resource.data.sede
        && validWellness(request.resource.data);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /Asistencias/{asistenciaId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /Pagos/{pagoId} {
      allow read: if isStaffFor(resource.data.sede)
        || isOwnStudent(resource.data.alumnoId);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Libro auxiliar para ingresos distintos a mensualidades y egresos.
    // Los Pagos existentes permanecen en su colección y nunca se duplican.
    match /MovimientosFinancieros/{movimientoId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.tipo in ['ingreso', 'egreso']
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 10000000
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 2
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 2
        && request.resource.data.concepto.size() <= 140
        && request.resource.data.fecha is timestamp
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly([
          'sede', 'tipo', 'monto', 'categoria', 'concepto',
          'fecha', 'creadoPor', 'creadoEn'
        ]);
      // Solo el administrador o el autor pueden corregir un egreso manual.
      // Origen, tipo, sede y datos de creación permanecen inmutables.
      allow update: if isStaffFor(resource.data.sede)
        && (isAdmin() || resource.data.creadoPor == request.auth.uid)
        && resource.data.tipo == 'egreso'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'monto', 'categoria', 'concepto', 'fecha',
          'actualizadoPor', 'actualizadoEn', 'revision'
        ])
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.monto <= 10000000
        && request.resource.data.categoria is string
        && request.resource.data.categoria.size() >= 2
        && request.resource.data.categoria.size() <= 60
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() >= 2
        && request.resource.data.concepto.size() <= 140
        && request.resource.data.fecha is timestamp
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      allow delete: if isAdmin()
        || (isStaffFor(resource.data.sede) && resource.data.creadoPor == request.auth.uid);
    }

    match /VinculacionesRFID/{vinculacionId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Índice de unicidad administrado exclusivamente por las APIs del servidor.
    // Un UID solo puede apuntar a un alumno, incluso con solicitudes simultáneas.
    match /TarjetasRFID/{rfid} {
      allow read, write: if false;
    }

    match /Pantallas/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId);
      allow delete: if isAdmin();
    }

    match /Anuncios/{anuncioId} {
      allow read: if isStaffFor(resource.data.sede)
        || isAthleteFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    // Calendarios de entrenamiento. El público sólo consulta publicaciones;
    // cada profesor administra su sede y el administrador puede gestionar todas.
    match /Calendarios/{calendarioId} {
      allow read: if resource.data.estado == 'publicado'
        || isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.estado == 'borrador';
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();
    }

    // Puntero ligero al calendario vigente de cada sede.
    match /CalendariosActuales/{sedeId} {
      allow read: if true;
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isStaffFor(sedeId);
    }

    match /Clases/{claseId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();
    }

    match /ClasesActivas/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isStaffFor(sedeId);
    }

    // Control independiente de la puerta del tatami. Puede utilizarse exista
    // o no una clase activa; el ESP32 lo consulta mediante una API protegida.
    match /ControlesAcceso/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow create, update: if isStaffFor(sedeId)
        && request.resource.data.sede == sedeId;
      allow delete: if isAdmin();
    }

    // Telemetría del controlador físico. El ESP32 escribe exclusivamente por
    // la API protegida; el panel sólo necesita leer el estado de su sede.
    match /DispositivosAcceso/{sedeId} {
      allow read: if isStaffFor(sedeId);
      allow write: if false;
    }

    // Incidencias compartidas por sede; no admite códigos RFID.
    match /IncidenciasOperativas/{incidenciaId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.estado == 'abierta'
        && request.resource.data.prioridad in ['baja', 'media', 'alta']
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 4
        && request.resource.data.titulo.size() <= 100
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() >= 8
        && request.resource.data.detalle.size() <= 600
        && request.resource.data.creadoEn == request.time
        && request.resource.data.keys().hasOnly([
          'sede', 'titulo', 'detalle', 'prioridad', 'estado',
          'actorUid', 'actorEmail', 'creadoEn'
        ]);
      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.actorUid == resource.data.actorUid
        && request.resource.data.estado in ['abierta', 'resuelta'];
      allow delete: if isAdmin();
    }

    match /AsistenciasClase/{registroId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update, delete: if isStaffFor(resource.data.sede);
    }

    match /ReservasClases/{claseId} {
      allow read: if isStaffFor(resource.data.sede)
        || (isAthleteFor(resource.data.sede) && resource.data.estado == 'publicada');
      allow create: if isStaffFor(request.resource.data.sede)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'publicada'
        && request.resource.data.reservados == 0
        && request.resource.data.cupo is int
        && request.resource.data.cupo >= 1
        && request.resource.data.cupo <= 200;
      allow update: if isStaffFor(resource.data.sede)
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.cupo >= resource.data.reservados;
      allow delete: if isAdmin();

      match /inscripciones/{userId} {
        allow read: if isStaffFor(
          get(/databases/$(database)/documents/ReservasClases/$(claseId)).data.sede
        ) || (signedIn() && request.auth.uid == userId);
        // Las inscripciones se procesarán por API transaccional para impedir
        // sobrecupo y duplicados. El cliente nunca ajusta el contador.
        allow write: if false;
      }
    }

    // Auditoría inmutable. El usuario autenticado puede crear movimientos
    // únicamente en una sede que administra; nunca editarlos ni borrarlos.
    match /Auditoria/{sede}/movimientos/{movimientoId} {
      allow read: if isStaffFor(sede);
      allow create: if isStaffFor(sede)
        && request.resource.data.sede == sede
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in [
          'crear',
          'editar',
          'eliminar',
          'activar',
          'desactivar',
          'registrar_pago',
          'editar_pago',
          'cancelar_pago',
          'agregar_asistencia',
          'eliminar_asistencia',
          'reiniciar_asistencias'
        ]
        && request.resource.data.entity in [
          'alumno',
          'pago',
          'asistencia',
          'rfid'
        ]
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 240
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'action',
          'entity',
          'entityId',
          'entityName',
          'summary',
          'reason',
          'details',
          'before',
          'after',
          'sede',
          'actorUid',
          'actorName',
          'actorEmail',
          'createdAt'
        ]);
      allow update, delete: if false;
    }

    // Sesiones privadas de examen. Las inscripciones públicas y las
    // evaluaciones de sinodales escriben exclusivamente mediante APIs
    // validadas; el personal administra los documentos desde el panel.
    match /ExamenesTaekwondo/{examenId} {
      allow read: if isStaffFor(resource.data.sede);
      allow create: if isStaffFor(request.resource.data.sede);
      allow update: if isStaffFor(resource.data.sede)
        && isStaffFor(request.resource.data.sede)
        && request.resource.data.sede == resource.data.sede;
      allow delete: if isAdmin();

      match /{documento=**} {
        allow read, write: if isStaffFor(
          get(
            /databases/$(database)/documents/ExamenesTaekwondo/$(examenId)
          ).data.sede
        );
      }
    }

    // Espejo de sesión para sincronización multidispositivo. El token del
    // documento es aleatorio; el público sólo lee y nunca escribe directo.
    match /ExamenEvaluacionPublica/{token} {
      allow read: if true;
      allow create, update: if isStaffFor(request.resource.data.sede);
      allow delete: if isStaffFor(resource.data.sede);
    }

    match /perfiles/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /{subdocumento=**} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    match /alimentos/{alimentoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contadores internos del servidor. Nunca son accesibles desde el SDK cliente.
    match /RateLimits/{limitId} {
      allow read, write: if false;
    }

    // Suscripciones FCM y bitácora mensual. Sólo las rutas de servidor y las
    // funciones programadas pueden leer o modificar estos documentos.
    match /DispositivosNotificacion/{dispositivoId} {
      allow read, write: if false;
    }

    match /RecordatoriosPago/{recordatorioId} {
      allow read, write: if false;
    }

    // Telemetría técnica con retención limitada, escrita solo por el servidor.
    match /ErroresWeb/{errorId} {
      allow read, write: if false;
    }

    // Bloques de diagnóstico del ESP32. Sólo las APIs autenticadas del
    // servidor pueden escribirlos o consultarlos; nunca el SDK del navegador.
    match /MonitorDispositivos/{sede}/{documento=**} {
      allow read, write: if false;
    }
  }
}
