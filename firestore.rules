rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REGLAS TÁCTICAS ALBATROS (Hardware & API) ---
    
    // Permitir que la API y el Hardware gestionen vinculaciones
    match /VinculacionesRFID/{vincId} {
      allow read, write: if true;
    }

    // Permitir registro de asistencias desde el ESP32 a través de la API
    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }

    // Permitir a la API actualizar el campo RFID de los alumnos
    // y lectura pública para validaciones de hardware
    match /Alumnos/{alumnoId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid', 'estadoPago']);
      allow write: if request.auth != null; // Protegido para creación/borrado manual
    }

    // --- REGLAS DE USUARIO Y PERFILES ---

    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /mealLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /trainingSessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /recipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Colección de alimentos (Lectura para todos los atletas)
    match /alimentos/{alimentoId} {
      allow read: if request.auth != null;
    }
  }
}