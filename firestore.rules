
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfiles de Usuario
    match /perfiles/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Alimentos (Arsenal Nutricional)
    match /alimentos/{foodItemId} {
      allow read: if true;
    }
    
    // Registro de Eventos (Público)
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if true;
    }

    // Alumnos (Gestión Administrativa con PIN)
    // Se permite el acceso sin auth para soportar el sistema de login por PIN de profesor
    match /Alumnos/{document=**} {
      allow read, write: if true;
    }

    // Admin alumnos (Colección secundaria)
    match /admin_alumnos/{document=**} {
      allow read, write: if true;
    }

    // Admin pagos
    match /admin_pagos/{document=**} {
      allow read, write: if true;
    }
  }
}
