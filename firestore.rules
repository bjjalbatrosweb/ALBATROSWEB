rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permisos para el flujo táctico RFID (Hardware y API)
    match /VinculacionesRFID/{vincId} {
      allow read, write: if true;
    }

    match /Asistencias/{asistenciaId} {
      allow read, write: if true;
    }

    match /Alumnos/{alumnoId} {
      allow read: if true;
      // Permite actualizar solo rfid y estadoPago desde la API
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rfid', 'estadoPago']);
      allow write: if request.auth != null;
    }

    // Perfiles y bitácoras (Protegidos)
    match /perfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /alimentos/{alimentoId} {
      allow read: if true;
    }
  }
}
