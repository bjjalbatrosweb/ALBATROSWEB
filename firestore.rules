rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario
    match /perfiles/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (Acceso Maestro)
    // Se permite lectura (get/list) y escritura a cualquier usuario autenticado
    match /admin_alumnos/{alumnoId} {
      allow read, write: if isSignedIn();
    }

    match /admin_pagos/{pagoId} {
      allow read, write: if isSignedIn();
    }

    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}