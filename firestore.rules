rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para perfiles de usuario (Acceso Guerrero)
    match /perfiles/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Reglas para administración (Acceso Maestro)
    // Se permite listado y gestión total a usuarios autenticados (Admin vía login táctico)
    // Se utiliza read para englobar get y list de forma explícita
    match /admin_alumnos/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /admin_pagos/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Reglas adicionales para la base de datos pública
    match /alimentos/{foodItemId} {
      allow read: if isSignedIn();
    }
    
    match /registro_eventos/{registrationId} {
      allow create: if true;
      allow read: if isSignedIn();
    }
  }
}